# 모든 IDE(IntelliJ, WebStorm, VS Code)가 같은 형식으로 파일을 저장하도록 맞춘다
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
